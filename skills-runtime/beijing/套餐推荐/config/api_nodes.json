{
  "_domain_fallbacks": {
    "current_package": "extra_data.currentMainOffer"
  },
  "北京测试接口_api": {
    "enabled": true,
    "_comment": "营销推荐话术获取接口",
    "url": "http://restapi.ngcrmpfcore-bj.cs.bj.cmos:8080/ngcrmpfcore_bj/csf/business/productRecommend",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "x-Channel-ID": "ngbusi"
    },
    "timeout": 30,
    "max_retries": 2,
    "mock_mode": true,
    "request_body_wrapper": "params",
    "request_template": {
      "ioId": "",
      "intent": "{{INTENT}}",
      "phone": "{{PHONE}}",
      "currentMainOffer": {
        "curOfferName": "{{extra_data.currentMainOffer.curOfferName}}",
        "curOfferId": "{{extra_data.currentMainOffer.curOfferId}}",
        "curOfferFee": "{{extra_data.currentMainOffer.curOfferFee}}"
      }
    },
    "response_extract": {
      "current_package": "bean.mainoffer",
      "recommended_packages": "bean.recommend_results"
    },
    "field_transform": {
      "usage.data_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "近3月流量饱和度",
          "近6月平均流量饱和度",
          "近3月平均流量(MB）",
          "近6月平均流量(MB）",
          "近3月平均流量饱和度",
          "实际近3月平均流量（GB）",
          "实际近6月平均流量（GB）"
        ],
        "unit_convert": {
          "近3月平均流量(MB）": "mb_to_gb",
          "近6月平均流量(MB）": "mb_to_gb"
        },
        "field_rename": {
          "近3月平均流量(MB）": "近3月平均流量(GB)",
          "近6月平均流量(MB）": "近6月平均流量(GB)",
          "实际近3月平均流量（GB）": "近3月平均流量(GB)",
          "实际近6月平均流量（GB）": "近6月平均流量(GB)"
        }
      },
      "usage.voice_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "近3月语音饱和度",
          "近6月平均语音饱和度",
          "近3月平均语音饱和度",
          "近3月平均主叫时长",
          "近6月平均主叫时长",
          "实际近3月平均语音（分钟）",
          "实际近6月平均语音（分钟）"
        ],
        "field_rename": {
          "实际近3月平均语音（分钟）": "近3月平均主叫时长",
          "实际近6月平均语音（分钟）": "近6月平均主叫时长"
        }
      },
      "usage.consumption": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "近6月平均折后收入",
          "近3月平均折后收入",
          "近3月平均月消费",
          "近6月平均月消费",
          "实际近3月平均消费（元）",
          "实际近6月平均消费（元）"
        ],
        "field_rename": {
          "实际近3月平均消费（元）": "近3月平均月消费",
          "实际近6月平均消费（元）": "近6月平均月消费"
        }
      },
      "tags": {
        "from": "bean.tags",
        "type": "filter_exclude",
        "exclude_keys": [
          "近3月流量饱和度",
          "近6月平均流量饱和度",
          "近3月平均流量(MB）",
          "近6月平均流量(MB）",
          "近3月平均流量饱和度",
          "实际近3月平均流量（GB）",
          "实际近6月平均流量（GB）",
          "近3月语音饱和度",
          "近6月平均语音饱和度",
          "近3月平均语音饱和度",
          "近3月平均主叫时长",
          "近6月平均主叫时长",
          "实际近3月平均语音（分钟）",
          "实际近6月平均语音（分钟）",
          "近6月平均折后收入",
          "近3月平均折后收入",
          "近3月平均月消费",
          "近6月平均月消费",
          "实际近3月平均消费（元）",
          "实际近6月平均消费（元）",
          "超套流量",
          "套外语音（分钟）"
        ]
      },
      "_unit_conversions": [
        {
          "target_path": "usage.data_usage",
          "field": "近3月平均流量(MB）",
          "new_field": "近3月平均流量(GB)",
          "converter": "mb_to_gb",
          "desc": ""
        },
        {
          "target_path": "usage.data_usage",
          "field": "近6月平均流量(MB）",
          "new_field": "近6月平均流量(GB)",
          "converter": "mb_to_gb",
          "desc": ""
        }
      ]
    },
