# 开发环境配置
# 构建命令：npm run dev 或 npm run build:dev

# 与灰度环境保持一致：BASE_URL=/znhs-gray/，API 路径 /znhs-gray/api/...
# 开发与灰度唯一区别是鉴权（灰度开启，开发关闭）
VITE_APP_PREFIX=gray
# 端口被占用时 vite 会直接报错（strictPort），需先结束占用进程
# 若 5173 被占用（如 Cursor 内置进程），改成其他端口如 5174
VITE_APP_PORT=5174
VITE_API_URL_PREFIX=
VITE_SUB_APP_ENVIRONMENT=true







