    "build:gray": "vite build --mode gray",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "build:artifact:prod": "vite build --mode production --outDir dist-prod",
    "build:artifact:gray": "vite build --mode gray --outDir dist-gray",
    "build:artifact:dev": "vite build --mode development --outDir dist-dev",
    "build:artifacts": "npm run build:artifact:prod && npm run build:artifact:gray && npm run build:artifact:dev"
  },
