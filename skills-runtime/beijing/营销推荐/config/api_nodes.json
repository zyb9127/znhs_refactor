  "营销推荐接口": {
    "_comment": "营销推荐接口",
    "url": "http://restapi.ngcrmpfcore-bj.cs.bj.cmos:8080/ngcrmpfcore_bj/csf/business/productRecommend",
    "method": "POST",
    "enabled": true,
    "source_type": "api",
    "request_template": {
      "params": {
        "phone": "{{PHONE}}",
        "ioId": "{{extra_data.ioId}}",
        "intent": "{{INTENT}}",
        "currentMainOffer": {
          "curOfferName": "{{extra_data.currentMainOffer.curOfferName}}",
          "curOfferId": "{{extra_data.currentMainOffer.curOfferId}}",
          "curOfferFee": "{{extra_data.currentMainOffer.curOfferFee}}"
        },
        "iop_products": "{{extra_data.iop_products}}"
      }
    },
    "response_extract": {
      "recommended_packages": "bean.recommend_results",
      "usage": "bean.tags"
    },
    "field_transform": {
      "usage.consumption": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均消费",
          "实际近6月平均消费"
        ],
        "field_rename": {
          "实际近3月平均消费": "近3月平均月消费",
          "实际近6月平均消费": "近6月平均月消费"
        }
      },
      "usage.data_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均流量",
          "实际近6月平均流量"
        ],
        "field_rename": {
          "实际近3月平均流量": "近3月平均流量(GB)",
          "实际近6月平均流量": "近6月平均流量(GB)"
        }
      },
      "usage.voice_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均语音",
          "实际近6月平均语音"
        ],
        "field_rename": {
          "实际近3月平均语音": "近3月平均主叫时长(分钟)",
          "实际近6月平均语音": "近6月平均主叫时长(分钟)"
        }
      },
      "tags": {
        "from": "bean.tags",
        "type": "filter_exclude",
        "exclude_keys": [
          "实际近3月平均消费",
          "实际近6月平均消费",
          "实际近3月平均流量",
          "实际近6月平均流量",
          "实际近6月平均语音",
          "实际近3月平均语音"
        ]
      },
      "_unit_conversions": []
    },
    "mock_mode": false,
