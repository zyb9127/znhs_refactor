{
  "北京营销推荐接口_api": {
    "_comment": "营销推荐意图下话术调用接口",
    "url": "http://restapi.ngcrmpfcore-bj.cs.bj.cmos:8080/ngcrmpfcore_bj/csf/business/productRecommend",
    "method": "POST",
    "enabled": true,
    "created_by": "admin",
    "request_template": {
      "ioId": "{{extra_data.ioId}}",
      "intent": "{{INTENT}}",
      "phone": "{{PHONE}}",
      "currentMainOffer": {
        "curOfferName": "{{extra_data.currentMainOffer.curOfferName}}",
        "curOfferId": "{{extra_data.currentMainOffer.curOfferId}}",
        "curOfferFee": "{{extra_data.currentMainOffer.curOfferFee}}"
      },
      "iop_products": "{{extra_data.iop_products}}"
    },
    "response_extract": {
      "current_package": "bean.mainoffer",
      "recommended_packages": "bean.recommend_results"
    },
    "field_transform": {
      "usage.data_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均流量（GB）",
          "实际近6月平均流量（GB）"
        ],
        "field_rename": {
          "实际近3月平均流量（GB）": "近3月平均流量(GB)",
          "实际近6月平均流量（GB）": "近6月平均流量(GB)"
        }
      },
      "usage.voice_usage": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均语音（分钟）",
          "实际近6月平均语音（分钟）"
        ],
        "field_rename": {
          "实际近3月平均语音（分钟）": "近3月平均主叫时长",
          "实际近6月平均语音（分钟）": "近6月平均主叫时长"
        }
      },
      "usage.consumption": {
        "from": "bean.tags",
        "type": "filter_include",
        "include_keys": [
          "实际近3月平均消费（元）",
          "实际近6月平均消费（元）"
        ],
        "field_rename": {
          "实际近3月平均消费（元）": "近3月平均月消费",
          "实际近6月平均消费（元）": "近6月平均月消费"
        }
      },
      "tags": {
        "from": "bean.tags",
        "type": "filter_exclude",
        "exclude_keys": [
          "实际近3月平均流量（GB）",
          "实际近6月平均流量（GB）",
          "实际近3月平均语音（分钟）",
          "实际近6月平均语音（分钟）",
          "实际近3月平均消费（元）",
          "实际近6月平均消费（元）",
          "超套流量",
          "套外语音（分钟）"
        ]
      }
    },
