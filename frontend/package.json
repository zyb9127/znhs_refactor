    "element-plus": "^2.7.0",
    "ling-yun-custom-components": "0.0.79",
    "ling-yun-methods": "0.0.56",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
