{
  "北京营销推荐接口_api": {
    "_comment": "营销推荐意图下话术调用接口",
    "url": "http://restapi.ngcrmpfcore-bj.cs.bj.cmos:8080/ngcrmpfcore_bj/csf/business/productRecommend",
    "method": "POST",
    "enabled": true,
    "created_by": "admin",
    "request_template": {
      "ioId": "{{extra_data.ioId}}",
      "intent": "{{INTENT}}",
      "phone": "{{PHONE}}",
      "currentMainOffer": {
        "curOfferName": "{{extra_data.currentMainOffer.curOfferName}}",
        "curOfferId": "{{extra_data.currentMainOffer.curOfferId}}",
        "curOfferFee": "{{extra_data.currentMainOffer.curOfferFee}}"
      },
      "iop_products": "{{extra_data.iop_products}}"
    },
    "response_extract": {
      "current_package": "bean.mainoffer",
      "recommended_packages": "bean.recommend_results",
      "raw_tags": "bean.tags"
    },
    "field_transform": {
      "current_package": {
        "from": "current_package",
        "type": "direct"
      },
      "recommended_packages": {
        "from": "recommended_packages",
        "type": "direct"
      },
      "usage.data_usage": {
        "from": "raw_tags",
        "type": "filter_include",
        "include_keys": [
          "近3月流量饱和度",
          "近6月平均流量饱和度",
          "近3月平均流量(MB）",
          "近6月平均流量(MB）",
          "近3月平均流量饱和度"
        ],
        "unit_convert": {
          "近3月平均流量(MB）": "mb_to_gb",
          "近6月平均流量(MB）": "mb_to_gb"
        },
        "field_rename": {
          "近3月平均流量(MB）": "近3月平均流量((GB)）",
          "近6月平均流量(MB）": "近6月平均流量((GB)）"
        }
      },
      "usage.voice_usage": {
        "from": "raw_tags",
        "type": "filter_include",
        "include_keys": [
          "近3月语音饱和度",
          "近6月平均语音饱和度",
          "近3月平均语音饱和度",
          "近3月平均主叫时长",
          "近6月平均主叫时长"
        ]
      },
      "usage.consumption": {
        "from": "raw_tags",
        "type": "filter_include",
        "include_keys": [
          "近3月平均折后收入",
          "近6月平均折后收入",
          "近3月平均月消费",
          "近6月平均月消费"
        ]
      },
      "tags": {
        "from": "raw_tags",
        "type": "filter_include",
        "include_keys": [
          "融合状态",
          "高频低额超套客户",
          "高频高额超套客户",
          "双卡机异网+移动但移动副卡",
          "低频低额超套或非超套客户",
          "双卡槽状态",
          "低频高额超套客户",
          "是否老旧套餐",
          "双卡机移动+异网且移动主卡",
          "分公司"
        ]
      },
      "_unit_conversions": [
        {
          "target_path": "usage.data_usage",
          "field": "近3月平均流量(MB）",
          "new_field": "近3月平均流量((GB)）",
          "converter": "mb_to_gb",
          "desc": ""
        },
        {
          "target_path": "usage.data_usage",
          "field": "近6月平均流量(MB）",
          "new_field": "近6月平均流量((GB)）",
          "converter": "mb_to_gb",
          "desc": ""
        }
      ]
    },
